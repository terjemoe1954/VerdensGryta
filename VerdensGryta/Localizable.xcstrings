    "Always check product labels and consider cross-contact. The app cannot guarantee that this dish is safe for an allergy." : {
      "comment" : "A disclaimer that the app cannot guarantee the safety of a dish.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nb" : {
